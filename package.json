{
  "name": "trenddrop",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint .",
    "db:generate": "node --env-file=.env.local node_modules/drizzle-kit/bin.cjs generate --config=drizzle.config.mjs",
    "db:push": "node --env-file=.env.local node_modules/drizzle-kit/bin.cjs push --config=drizzle.config.mjs",
    "db:migrate": "node --env-file=.env.local node_modules/drizzle-kit/bin.cjs migrate --config=drizzle.config.mjs",
    "collect": "node --env-file=.env.local pipeline/collect.mjs",
    "rank": "node --env-file=.env.local pipeline/rank-popular.mjs --save",
    "verify:ui": "node scripts/verify-ui.mjs"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.115.0",
    "drizzle-orm": "^0.45.2",
    "next": "^16.2.10",
    "postgres": "^3.4.9",
    "react": "^19.2.7",
    "react-dom": "^19.2.7",
    "react-markdown": "^10.1.0"
  },
  "devDependencies": {
    "@types/node": "^26.1.0",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "drizzle-kit": "^0.31.10",
    "eslint": "^9.39.4",
    "eslint-config-next": "^16.2.10",
    "typescript": "^6.0.3"
  }
}

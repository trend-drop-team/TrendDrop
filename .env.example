# ─────────────────────────────────────────────────────────────────────────────
# Database — server/backend only. Never expose these as NEXT_PUBLIC_* variables.
# ─────────────────────────────────────────────────────────────────────────────
DATABASE_URL=

# ─────────────────────────────────────────────────────────────────────────────
# Frontend — NEXT_PUBLIC_* values are bundled into browser JavaScript.
# The API URL is public by design; it must not contain credentials.
# ─────────────────────────────────────────────────────────────────────────────
# 프로덕션에서는 필수 — 비어 있으면 빌드가 아니라 요청 시점에 즉시 실패한다.
# (폴백을 두면 서버는 localhost, 브라우저는 same-origin을 보는 반쪽 동작이 된다)
NEXT_PUBLIC_API_URL=http://localhost:4000
# 공유 링크·OG 태그가 쓰는 서비스 주소. 공유 카드에 찍히는 주소이기도 하다.
NEXT_PUBLIC_SITE_URL=http://localhost:3000
# Kakao Developers의 앱 설정 > 플랫폼 키 > JavaScript 키
NEXT_PUBLIC_KAKAO_JS_KEY=

# ─────────────────────────────────────────────────────────────────────────────
# Backend — local development. Render provides PORT automatically in production.
# ─────────────────────────────────────────────────────────────────────────────
BACKEND_PORT=4000
# CORS 허용 출처(쉼표 구분). NODE_ENV=production에서 비어 있으면 서버가 기동하지 않는다.
# 상태변경 라우트(POST/DELETE)의 Origin 헤더 검사(#94)도 이 값을 그대로 쓴다 —
# 프론트(Vercel)와 백엔드(Render)가 cross-site 배포라 쿠키의 SameSite만으로는 CSRF를 못 막는다.
FRONTEND_ORIGIN=http://localhost:3000
# 세션 쿠키(td-session) 서명 비밀키. 프로덕션에서 비어 있으면 로그인이 전부 실패한다
# (local-development 기본값은 NODE_ENV=development에서만 쓰인다). 운영자가 DB에서
# users.session_token_min_iat을 now()로 갱신하면 그 사용자의 기존 세션을 전부 폐기할 수 있다(#94).
AUTH_SESSION_SECRET=

# ─────────────────────────────────────────────────────────────────────────────
# External APIs — backend/pipeline only.
# ─────────────────────────────────────────────────────────────────────────────
YOUTUBE_API_KEY=
ANTHROPIC_API_KEY=

# ─────────────────────────────────────────────────────────────────────────────
# Pipeline — optional tuning values. Defaults are used when omitted.
# ─────────────────────────────────────────────────────────────────────────────
REGION_CODE=KR
VERDICT_MODEL=claude-sonnet-5
VERDICT_EFFORT=medium
# HOURS=6
# TOP_N=10
# POOL=50
# BATCH=60
